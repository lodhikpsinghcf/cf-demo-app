{
  "expo": {
    "name": "CF Demo",
    "slug": "cf-demo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#571FE4"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.contentflow.demo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#571FE4"
      },
      "package": "com.contentflow.demo"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "cfdemo",
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "contentflowApiKey": "ws_7d0194ac4b94287a59342f21_test",
      "contentflowBaseUrl": "https://api.contentflow.click"
    }
  }
}
